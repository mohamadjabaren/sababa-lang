# ==========================================
# ספריית אלגוריתמים (Algorithms Library)
# ==========================================

# חישוב עצרת (Factorial) ברקורסיה
פונקציה עצרת(n) {
    אם n <= 1 אז {
        תחזיר 1
    } אחרת {
        תחזיר n * עצרת(n - 1)
    }
}

# סדרת פיבונאצ'י (Fibonacci)
פונקציה פיבונאצ(n) {
    אם n <= 1 אז {
        תחזיר n
    } אחרת {
        תחזיר פיבונאצ(n - 1) + פיבונאצ(n - 2)
    }
}