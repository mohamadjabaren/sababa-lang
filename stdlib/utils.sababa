# ==========================================
# ספריית עזרים (Utilities Library)
# ==========================================

# מציאת המספר הגדול ביותר במערך (Find Max in Array)
פונקציה מקסימום(רשימה_שלי, כמות) {
    מספר הכי_גדול שים רשימה_שלי[0]
    
    לכל מספר i שים 1, i < כמות, i שים i + 1 {
        אם רשימה_שלי[i] > הכי_גדול אז {
            הכי_גדול שים רשימה_שלי[i]
        }
    }
    
    תחזיר הכי_גדול
}